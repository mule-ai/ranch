# ranchd — Ranch local daemon
# Installs a user-level systemd unit via `make service`.
#
# The daemon is the same `ranch` binary as the CLI — the `ranchd` argv0
# symlink (or `ranch daemon`) selects the daemon entrypoint.

[Unit]
Description=Ranch local daemon (PTY + libghostty-vt multiplexer)
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ranchd
Restart=on-failure
RestartSec=2

# Environment overrides (optional)
# Environment=RANCH_SOCKET=/custom/path/daemon.sock
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
